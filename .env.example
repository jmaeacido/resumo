APP_NAME=Resumo

# MySQL is used immediately. Laragon commonly uses root with an empty password.
DB_CONNECTION=mysql
DB_DATABASE=resumo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# AI providers. Groq is tried first, then Ollama, then local scoring.
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=1800
GROQ_BUTLER_MAX_TOKENS=450

OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=
OLLAMA_TIMEOUT=75
OLLAMA_CONTEXT=4096
OLLAMA_NUM_PREDICT=280
