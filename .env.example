APP_NAME=Resumo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/resumo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resumo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@resumo.local"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_RESUMO_API_KEY=

VITE_APP_NAME="${APP_NAME}"

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=1800
GROQ_BUTLER_MAX_TOKENS=450

OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=75
OLLAMA_CONTEXT=4096
OLLAMA_NUM_PREDICT=280
